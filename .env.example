# ============================================================
# Event Ticketing Platform - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=debug

# ---- JWT ----
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing_secret
POSTGRES_SSL_MODE=disable

# Per-service databases
USER_DB_NAME=user_db
EVENT_DB_NAME=event_db
BOOKING_DB_NAME=booking_db
PAYMENT_DB_NAME=payment_db
TICKET_DB_NAME=ticket_db
NOTIFICATION_DB_NAME=notification_db

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
SEAT_LOCK_TTL=300

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ---- Service Ports ----
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
EVENT_SERVICE_PORT=8082
BOOKING_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
TICKET_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086

# ---- Service URLs (internal Docker network) ----
USER_SERVICE_URL=http://user-service:8081
EVENT_SERVICE_URL=http://event-service:8082
BOOKING_SERVICE_URL=http://booking-service:8083
PAYMENT_SERVICE_URL=http://payment-service:8084
TICKET_SERVICE_URL=http://ticket-service:8085
NOTIFICATION_SERVICE_URL=http://notification-service:8086

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- Observability ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ---- Rate Limiting ----
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
